import matplotlib.pyplot as plt

# Dados para o gráfico
categorias = ['A', 'B', 'C', 'D']
valores = [10, 24, 15, 18]

# Criar o gráfico de barras
plt.bar(categorias, valores, color='skyblue')

# Adicionar título e rótulos
plt.title('Gráfico de Barras Simples')
plt.xlabel('Categorias')
plt.ylabel('Valores')

# Exibir o gráfico
plt.show()
